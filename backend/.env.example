# Copy to backend/.env for local development. Use generated secrets, not these
# placeholders. Never commit backend/.env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dermai_db
DB_USER=dermai_app
DB_PASSWORD=replace-with-local-database-password

JWT_SECRET_KEY=generate-a-unique-random-secret-at-least-32-characters
CSRF_SECRET_KEY=generate-a-different-random-secret-at-least-32-characters

APP_ENV=development
SESSION_COOKIE_NAME=dermai_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
SESSION_TOUCH_INTERVAL_SECONDS=60

CORS_DEVELOPMENT_ORIGINS=http://localhost:5173
# Production requires one or more exact HTTPS origins, comma-separated.
CORS_PRODUCTION_ORIGINS=
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Accept,Content-Type,X-CSRF-Token
CORS_PREFLIGHT_MAX_AGE_SECONDS=600

# Fixed-window limits. Shared PostgreSQL storage is used; these are not
# process-local counters. All login attempts, including successful attempts,
# consume the account and source-IP limits.
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_PER_ACCOUNT=10
LOGIN_RATE_LIMIT_PER_IP=100
REGISTER_RATE_LIMIT_PER_IP=20
CSRF_BOOTSTRAP_RATE_LIMIT_PER_IP=120

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MIN_IMAGE_SIDE=100
